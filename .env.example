# Flask Application Configuration
# Copy this file to .env and update with your values

# ===================
# Application Settings
# ===================
FLASK_ENV=development
APP_NAME=Flask API
APP_VERSION=0.0.1

# Security - Generate a strong secret key for production
# On Linux/Mac: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=dev-secret-key-change-in-production

# ===================
# Database Configuration
# ===================
# For local development with PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flask_db

# For local development with SQLite (uncomment to use)
# DATABASE_URL=sqlite:///dev.db

# Database credentials (only used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flask_db

# ===================
# Celery & Redis
# ===================
# Redis connection for Celery broker and result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# For production with password
# CELERY_BROKER_URL=redis://:password@redis-host:6379/0

# ===================
# Keycloak / Authentication
# ===================
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=flask-app
KEYCLOAK_CLIENT_SECRET=

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_VERIFY_EXPIRATION=True
JWT_VERIFY_SIGNATURE=True

# ===================
# Auth Provider Selection
# ===================
# Which authentication provider to use: "keycloak" or "jwks"
AUTH_PROVIDER=keycloak

# JWKS Auth Configuration (used when AUTH_PROVIDER=jwks)
# e.g. Hanko, Clerk, or any provider exposing a JWKS endpoint
JWKS_URL=http://localhost:3000/api/auth/jwks
JWKS_ISSUER=http://localhost:3000
JWKS_AUDIENCE=http://localhost:3000
JWKS_ALGORITHMS=EdDSA,RS256

# ===================
# CORS Configuration
# ===================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ===================
# Logging
# ===================
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ===================
# Server Settings (for gunicorn)
# ===================
PORT=8000
WORKERS=4
WORKER_CLASS=sync
TIMEOUT=30

# ===================
# Gunicorn Configuration (Optional - overrides gunicorn_config.py defaults)
# ===================
# These environment variables allow fine-tuning Gunicorn without editing gunicorn_config.py
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_BACKLOG=2048
# GUNICORN_WORKERS=4                    # Default: cpu_count * 2 + 1
# GUNICORN_TIMEOUT=30
# GUNICORN_KEEPALIVE=2
